# Supabase project settings (Project Settings > API)
SUPABASE_URL=https://xxxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ---------- AI_MODE: the one switch for both chat and embeddings ----------
# "web"   (default) — Groq for chat, Voyage AI for embeddings. Needs API keys.
# "local" — Ollama for both, on your machine. No API keys, no internet needed
#           for generation/embeddings, but Ollama must be running locally and
#           have the models pulled (see below).
# Switching this is just this one line — no code changes, on any branch.
AI_MODE=web

# ---------- Web mode: Groq (chat) + Voyage AI (embeddings) ----------
# Only needed when AI_MODE=web.
GROQ_API_KEY=gsk_...
VOYAGE_API_KEY=pa-...

# ---------- Local mode: Ollama (chat + embeddings) ----------
# Only needed when AI_MODE=local. No API key — Ollama is a local server with
# no auth. Requires the Ollama app (or `ollama serve`) running locally, and
# the models pulled once:
#   ollama pull llama3.1:8b
#   ollama pull mxbai-embed-large
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_CHAT_MODEL=llama3.1:8b
OLLAMA_EMBED_MODEL=mxbai-embed-large

# Note: switching AI_MODE only affects newly-uploaded documents — each chunk
# is tagged with the embedding model that produced it (documents.embedding_model
# in schema.sql), and only chunks matching the currently active model are
# shown/searched, since different embedding models aren't comparable even at
# the same vector dimensionality.
